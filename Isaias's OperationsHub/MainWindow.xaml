<Window x:Class="OperationsHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lov3rs Plaza ♡"
        Width="1120"
        Height="850"
        MinWidth="900"
        MinHeight="700"
        Background="#FFF5F8"
        Foreground="#71465A"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#F3BDD0"/>
            <Setter Property="Foreground" Value="#713E53"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#713E53"/>
            <Setter Property="BorderBrush" Value="#EBC4D3"/>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#713E53"/>
            <Setter Property="BorderBrush" Value="#EBC4D3"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- RESTAURANT HEADING -->
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="♡ LOV3RS PLAZA ♡"
                       FontSize="34"
                       FontWeight="Bold"
                       Foreground="#C46E91"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="good food • sweet moments • lovely things"
                       FontSize="14"
                       Foreground="#A47B8D"
                       HorizontalAlignment="Center"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <!-- MENU AND ORDER AREA -->
        <Grid Grid.Row="1" Margin="0,4,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- MENU -->
            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="#EBC4D3"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="14">

                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="♡ THE MENU"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#C46E91"
                               Margin="0,0,0,8"/>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding MenuItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="175"
                                            Margin="5"
                                            Padding="8"
                                            Background="#FFF5F8"
                                            BorderBrush="#F1D4DF"
                                            BorderThickness="1"
                                            CornerRadius="10">

                                        <StackPanel>
                                            <Border Height="100"
                                                    Background="#FBE4ED"
                                                    CornerRadius="7">
                                                <Image Source="{Binding ImagePath}"
                                                       Stretch="UniformToFill"/>
                                            </Border>

                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="Bold"
                                                       FontSize="15"
                                                       Foreground="#713E53"
                                                       Margin="0,8,0,3"
                                                       TextWrapping="Wrap"/>

                                            <TextBlock Text="{Binding Price, StringFormat={}{0:C}}"
                                                       Foreground="#C46E91"
                                                       Margin="0,0,0,5"/>

                                            <Button Content="♡ Add to order"
                                                    Tag="{Binding}"
                                                    Click="Add_Click"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ORDER AND TIMER -->
            <Border Grid.Column="2"
                    Background="#FCE7EF"
                    CornerRadius="14"
                    Padding="16">

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- YOUR ORDER -->
                        <TextBlock Text="YOUR ORDER ♡"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#B65F83"/>

                        <TextBlock Text="Select items from the menu."
                                   Foreground="#A47B8D"
                                   Margin="0,4,0,8"/>

                        <ListBox x:Name="lstItems"
                                 Height="155"
                                 SelectionMode="Single"
                                 DisplayMemberPath="DisplayName"/>

                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="Remove selected"
                                    Click="Remove_Click"/>

                            <Button Content="Clear order"
                                    Click="ClearOrder_Click"/>
                        </WrapPanel>

                        <TextBlock x:Name="txtTotal"
                                   Text="Total: $0.00"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#B65F83"
                                   Margin="0,8,0,12"/>

                        <Button Content="♡ PLACE ORDER"
                                FontSize="15"
                                Click="PlaceOrder_Click"/>

                        <Separator Margin="0,15,0,12"
                                   Background="#E9B6CB"/>

                        <!-- READY IN -->
                        <TextBlock Text="READY IN"
                                   Foreground="#B65F83"
                                   FontWeight="Bold"/>

                        <TextBlock x:Name="txtTimer"
                                   Text="15:00"
                                   FontSize="43"
                                   FontWeight="Bold"
                                   Foreground="#C46E91"
                                   Margin="0,2,0,0"/>

                        <TextBlock x:Name="txtStatus"
                                   Text="Welcome to Lov3rs Plaza! ♡"
                                   Foreground="#966C80"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,8"/>

                        <WrapPanel>
                            <Button Content="Start / Pause"
                                    Click="Timer_Click"/>

                            <Button Content="Reset"
                                    Click="Reset_Click"/>
                        </WrapPanel>

                        <Separator Margin="0,12,0,12"
                                   Background="#E9B6CB"/>

                        <!-- OUR PLAYLIST -->
                        <TextBlock Text="OUR PLAYLIST ♡"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#B65F83"/>

                        <TextBlock Text="A little music while you wait."
                                   Foreground="#966C80"
                                   Margin="0,4,0,6"/>

                        <Button Content="♫ Open Spotify playlist"
                                Click="Spotify_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- TEAM NOTES -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#EBC4D3"
                BorderThickness="1"
                CornerRadius="12"
                Padding="10">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Margin="12,0">
                    <TextBlock Text="TEAM NOTES ♡"
                               FontWeight="Bold"
                               Foreground="#B65F83"/>

                    <TextBox x:Name="txtDocument"
                             Height="43"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             ToolTip="Write your team contract or work report"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center">
                    <Button Content="Export notes"
                            Click="Save_Click"/>

                    <Button Content="Reopen notes"
                            Click="Open_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
